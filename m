+++ linux-2.6.6/Makefile	2004-05-11 19:20:59.000000000 +0200
@@ -449,6 +449,10 @@
 
 include $(srctree)/arch/$(ARCH)/Makefile
 
+# Let architecture Makefiles change CPPFLAGS if needed
